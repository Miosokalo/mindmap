# Mindmap-API (Chat → OpenRouter). Kopie als .env ablegen, nie committen.
# Key: https://openrouter.ai/keys  (beginnt mit sk-or-v1-)

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ohne Eintrag gelten diese Defaults:
OPENROUTER_MODEL_PUBLIC=deepseek/deepseek-chat-v3.1
OPENROUTER_MODEL_AUTH=anthropic/claude-sonnet-4.5

# Optional: Basic Auth für das stärkere Modell (Button „Schlüssel“ im Chat).
# Hash (Format scrypt$saltHex$hashHex):
#   node -e 'const c=require("crypto"),p=process.argv[1],s=c.randomBytes(16),h=c.scryptSync(p,s,32);console.log(`MINDMAP_CHAT_AUTH_HASH=scrypt$${s.toString("hex")}$${h.toString("hex")}`)' 'PASSWORT'
MINDMAP_CHAT_AUTH_USER=
MINDMAP_CHAT_AUTH_HASH=
